VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Production on Vercel uses VERCEL_OIDC_TOKEN automatically through AI Gateway.
# Do not copy VERCEL_OIDC_TOKEN into source or environment settings manually.
# Optional local/server fallbacks:
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_INTAKE_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
